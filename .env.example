# Chave secreta do Flask - usada para assinar cookies de sessão
# Gere uma usando o seguinte comando: python3 -c "import secrets; print(secrets.token_hex(32))"
# Substitua o valor de SECRET_KEY com a chave gerada pelo comando acima
# Ex: SECRET_KEY=7179880a...
# Em seguida renomeie o arquivo atual para ".env"

SECRET_KEY=replace-with-a-random-secret-key
